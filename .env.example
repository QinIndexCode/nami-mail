HOST=127.0.0.1
PORT=3187
DATABASE_PATH=./data/nami-mail.db
MASTER_KEY_PATH=./data/master.key
# Per-folder mailbox sync cap: 0 = whole mailbox (like Gmail's web client).
# An explicitly set value overrides the in-app setting (Settings → Sync), whose
# default is 2000.
SYNC_MESSAGE_LIMIT=2000
LOG_LEVEL=info

# Desktop OAuth configuration: the installed Windows app reads only the four
# settings below from %APPDATA%\Nami Mail\nami-mail.env. The development
# desktop app uses its project-root .env only as a fallback after that file.
# OS environment variables supplied when Nami Mail starts take precedence.
# The installed file cannot set HOST, PORT, database, or key paths.
# These are public client IDs, tenant, and TTL only; never put a client secret
# in this desktop or loopback application.
# Google must use a Google Cloud Desktop app client and the runtime callback is
# http://127.0.0.1:<dynamic-port>/api/oauth/google/callback.
# Microsoft must use a Mobile and desktop applications/public client with a
# registered http://localhost loopback redirect. Its runtime callback is
# http://localhost:<dynamic-port>/api/oauth/microsoft/callback via IPv6 ::1.
NAMI_MAIL_GOOGLE_OAUTH_CLIENT_ID=
NAMI_MAIL_MICROSOFT_OAUTH_CLIENT_ID=
# Microsoft Entra tenant: common, organizations, consumers, or a tenant ID.
NAMI_MAIL_MICROSOFT_TENANT=common
# Pending authorization lifetime in seconds (60-900).
NAMI_MAIL_OAUTH_FLOW_TTL_SECONDS=600

# Optional startup fallback for user-triggered message translation through a LibreTranslate-compatible service.
# The endpoint must be HTTPS, or local loopback HTTP, and must end with /translate.
# Examples: https://translate.example.com/translate or http://127.0.0.1:5000/translate
NAMI_MAIL_TRANSLATION_ENDPOINT=
# Optional service API key. Keep it in the process environment or this development .env.
# In the installed desktop app, save user-managed keys in Settings > Translation service;
# do not add them to %APPDATA%\Nami Mail\nami-mail.env.
NAMI_MAIL_TRANSLATION_API_KEY=
# Translation request timeout in milliseconds (1000-60000; default 25000).
NAMI_MAIL_TRANSLATION_TIMEOUT_MS=25000

# Directory containing the built web client that the server serves
# (default ./apps/web/dist). The desktop host always points this at its own
# packaged assets, so this only matters for standalone/dev server runs.
WEB_DIST_PATH=./apps/web/dist

# Optional local API access token for standalone (non-desktop) runs. The
# Electron host does not read this variable: it passes its capability directly
# to the server so child processes never inherit it from the environment.
NAMI_MAIL_LOCAL_API_TOKEN=

# Kill switch for local diagnostic log appends (startup-request-log.jsonl next
# to the database; the desktop shares the same process environment, so the
# setting also covers the desktop runtime log). Set to 1 to stop all appends;
# existing oversized logs are still pruned. Leave unset to keep diagnostics.
# NAMI_MAIL_NO_STARTUP_LOG=1

# Remote-image proxy cache tuning for images referenced by sanitized mail HTML.
# Values must be positive integers; unset or invalid values fall back to the
# defaults shown here.
# Total cache ceiling in MB (default 200).
NAMI_MAIL_IMAGE_CACHE_MAX_MB=200
# Images not accessed within this many days are evicted (default 7).
NAMI_MAIL_IMAGE_CACHE_MAX_DAYS=7
# Single-image ceiling in MB — larger remote images are not cached (default 10).
NAMI_MAIL_IMAGE_CACHE_MAX_FILE_MB=10
# Wall-clock deadline in milliseconds for transferring one remote image body
# (default 60000).
NAMI_MAIL_IMAGE_TRANSFER_TIMEOUT_MS=60000
