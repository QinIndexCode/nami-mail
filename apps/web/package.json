{
  "name": "@nami/web",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "predev": "node ../../scripts/copy-pdfjs-assets.mjs --ensure",
