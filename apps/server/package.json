{
  "name": "@nami/server",
  "version": "0.4.3",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node ../../scripts/build-locale-catalog.mjs",
    "dev": "node ../../scripts/run-server-node.mjs --watch",
    "prebuild": "node ../../scripts/build-locale-catalog.mjs",
    "build": "tsc -p tsconfig.json",
    "start": "node ../../scripts/run-server-node.mjs --start",
    "pretest": "node ../../scripts/build-locale-catalog.mjs --check",
    "test": "node ../../scripts/run-server-tests.mjs",
    "pretypecheck": "node ../../scripts/build-locale-catalog.mjs --check",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/static": "^10.1.4",
    "@nami/agent-contracts": "file:../../packages/agent-contracts",
    "@nami/agent-core": "file:../../packages/agent-core",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.5",
    "fastify": "^5.12.1",
    "imapflow": "^2.0.2",
    "mailparser": "^3.9.15",
    "nodemailer": "^10.0.13",
    "oauth4webapi": "^3.8.6",
    "sharp": "^0.35.5",
    "yazl": "^3.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^26.1.1",
    "@types/nodemailer": "^8.0.1",
    "@types/yazl": "^3.3.1",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2",
    "vitest": "^4.0.18"
  }
}
