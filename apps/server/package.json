{
  "name": "@nami/server",
  "version": "0.4.2",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node ../../scripts/build-locale-catalog.mjs",
    "dev": "node ../../scripts/run-server-node.mjs --watch",
    "prebuild": "node ../../scripts/build-locale-catalog.mjs",
    "build": "tsc -p tsconfig.json",
    "start": "node ../../scripts/run-server-node.mjs --start",
    "pretest": "node ../../scripts/build-locale-catalog.mjs --check",
    "test": "node ../../scripts/run-server-tests.mjs",
    "pretypecheck": "node ../../scripts/build-locale-catalog.mjs --check",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/static": "^10.1.3",
    "@nami/agent-contracts": "file:../../packages/agent-contracts",
    "@nami/agent-core": "file:../../packages/agent-core",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.2.3",
    "fastify": "^5.12.1",
    "imapflow": "^2.0.2",
    "mailparser": "^3.9.15",
    "nodemailer": "^9.1.1",
    "oauth4webapi": "^3.8.6",
    "sharp": "^0.35.3",
    "yazl": "^3.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^26.6.2",
    "@types/nodemailer": "^8.0.1",
    "@types/yazl": "^3.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
