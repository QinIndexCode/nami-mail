{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Tests may reach one directory up for cross-workspace data-parity
    // contracts (demo-providers imports the web catalog to assert it mirrors
    // the server preset list). noEmit makes the wider rootDir safe: this
    // config never emits, it only type-checks.
    "rootDir": "..",
    "noEmit": true
  },
  // The two web modules are plain data/vocabulary with no React imports, so
  // the server suite can assert the two sides agree instead of restating the
  // lists in a comment (contract §8 G11/G12).
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "../web/src/demoProviderCatalog.ts",
    "../web/src/realtimeEventNames.ts",
    "../web/src/taskStatuses.ts"
  ],
  "exclude": ["dist", "node_modules"]
}
