{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "types": ["node", "vitest/globals"],
    "sourceMap": true,
    // `better-sqlite3-multiple-ciphers` ships `index.d.ts`, but its package
    // `exports` map lists only JS entry points and no `types` condition, so
    // NodeNext resolution treats those declarations as unreachable and every
    // import of the driver silently degrades to `any`. Point the specifier at
    // the shipped declaration file rather than vendoring a copy or re-adding
    // DefinitelyTyped's `@types/better-sqlite3`, which would drift from the
    // installed version. Runtime is unaffected: src/native-sqlite.ts loads the
    // driver through `createRequire`, and `paths` is type-resolution only.
    "paths": {
      "better-sqlite3-multiple-ciphers": ["../../node_modules/better-sqlite3-multiple-ciphers/index.d.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
